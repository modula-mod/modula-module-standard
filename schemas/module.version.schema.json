{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modula.digital/schemas/mms/0.1.0/module.version.schema.json",
  "title": "Modula Module Version",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "date": {"type": "string"},
    "notes": {"type": "string"}
  }
}

