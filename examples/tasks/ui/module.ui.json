{
  "schemaVersion": "0.3.0",
  "moduleId": "tasks",
  "entry": "screens.index",
  "theme": {
    "preferredSurface": "solid",
    "accentRole": "productivity"
  },
  "screens": {
    "index": {
      "$ref": "ui/screens/index.ui.json"
    },
    "detail": {
      "$ref": "ui/screens/detail.ui.json"
    },
    "editor": {
      "$ref": "ui/screens/editor.ui.json"
    },
    "settings": {
      "$ref": "ui/screens/settings.ui.json"
    }
  },
  "actions": {
    "createTask": {
      "label": "New task",
      "kind": "create",
      "resource": "tasks",
      "defaultPayload": {
        "title": "New task",
        "priority": "normal"
      }
    },
    "toggleTask": {
      "label": "Toggle",
      "kind": "toggle",
      "resource": "tasks",
      "field": "done",
      "requiresSelection": true
    },
    "deleteTask": {
      "label": "Delete",
      "kind": "delete",
      "resource": "tasks",
      "requiresSelection": true,
      "confirm": true,
      "destructive": true
    },
    "filterTasks": {
      "label": "Filter",
      "kind": "filter",
      "resource": "tasks"
    }
  },
  "resources": {
    "tasks": {
      "type": "collection",
      "endpoint": "/api/modula/tasks",
      "responseKey": "tasks",
      "itemResponseKey": "task",
      "idField": "id",
      "titleField": "title",
      "statusField": "done",
      "searchFields": ["title"],
      "methods": {
        "list": "GET",
        "create": "POST",
        "update": "PATCH",
        "delete": "DELETE"
      }
    }
  }
}
