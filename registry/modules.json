        },
        "collections": [
          {
            "id": "notes",
            "label": "Notes",
            "schema": "data/schema.json",
            "indexes": "data/indexes.json"
          }
        ],
        "migrations": [
          "data/migrations/001-initial.json"
        ],
        "ownerTypes": [
          "user",
          "team",
          "business"
        ],
        "backup": true,
        "export": true
      },
