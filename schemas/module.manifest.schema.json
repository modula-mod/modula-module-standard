{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modula.digital/schemas/mms/0.2.0/module.manifest.schema.json",
  "title": "Modula Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mmsVersion",
    "id",
    "name",
    "version",
    "status",
    "category",
    "description",
    "source",
    "entry",
    "ownerTypes",
    "permissions",
    "surfaces",
    "capabilities",
    "data",
    "ui",
    "lifecycle",
    "compatibility",
    "minimumModulaVersion",
    "changelog",
    "integrity"
  ],
  "properties": {
    "mmsVersion": {"const": "0.2.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"},
    "status": {
      "type": "string",
      "enum": ["local", "core", "installed", "available", "planned", "disabled", "archived"]
    },
    "category": {"type": "string", "minLength": 1},
    "categories": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "description": {"type": "string", "minLength": 1},
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "path"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "surface": {"type": "string"}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repo", "ref"],
      "properties": {
        "type": {"type": "string", "enum": ["github"]},
        "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "ref": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "route"],
      "properties": {
        "type": {"type": "string", "enum": ["host-rendered", "package-rendered", "modula-ui-contract"]},
        "route": {"type": "string", "minLength": 1},
        "component": {"type": "string", "minLength": 1}
      }
    },
    "ownerTypes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["user", "team", "business"]}
    },
    "permissions": {"$ref": "module.permissions.schema.json"},
    "surfaces": {
      "oneOf": [
        {
          "type": "array",
          "items": {"type": "string", "enum": ["board", "profile", "settings", "route", "search", "event", "marketplace"]},
          "uniqueItems": true
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["board", "profile", "settings"],
          "properties": {
            "board": {"type": "boolean"},
            "profile": {"type": "boolean"},
            "settings": {"type": "boolean"}
          }
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "update", "uninstall"],
      "properties": {
        "install": {"type": "string", "enum": ["manual", "automatic", "core"]},
        "update": {"type": "string", "enum": ["manual", "automatic"]},
        "uninstall": {"type": "string", "enum": ["preserve-data", "delete-data-prohibited"]},
        "installable": {"type": "boolean"},
        "updateable": {"type": "boolean"},
        "rollbackable": {"type": "boolean"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumModulaVersion"],
      "properties": {
        "minimumModulaVersion": {"type": "string"},
        "minModulaVersion": {"type": "string"},
        "minHostVersion": {"type": "string"},
        "hostRendered": {"type": "boolean"}
      }
    },
    "data": {"$ref": "module.data.schema.json"},
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usesDesignStandard",
        "supportsSurfaceTypes",
        "supportsTextScale",
        "supportsReduceMotion"
      ],
      "properties": {
        "type": {"type": "string", "enum": ["host-rendered", "modula-ui-contract", "package-rendered"]},
        "schemaVersion": {"type": "string"},
        "entry": {"type": "string", "minLength": 1},
        "usesDesignStandard": {"type": "boolean"},
        "supportsSurfaceTypes": {"type": "boolean"},
        "supportsTextScale": {"type": "boolean"},
        "supportsReduceMotion": {"type": "boolean"}
      }
    },
    "minimumModulaVersion": {"type": "string"},
    "changelog": {
      "type": "array",
      "items": {"$ref": "module.version.schema.json"}
    },
    "changelogSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {"type": "string", "enum": ["github"]},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "signature"],
      "properties": {
        "hash": {"type": ["string", "null"]},
        "signature": {"type": ["string", "null"]}
      }
    }
  }
}
