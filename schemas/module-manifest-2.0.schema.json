{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modula.digital/schemas/module-standard/2.0.0/manifest.schema.json",
  "title": "Modula Module Standard 2.0 Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "standardVersion",
    "moduleVersion",
    "manifestSchemaVersion",
    "dataSchemaVersion",
    "id",
    "slug",
    "name",
    "description",
    "publisher",
    "compatibility",
    "lifecycle",
    "permissions",
    "capabilities",
    "records",
    "views",
    "actions",
    "functions",
    "settings",
    "events",
    "automations",
    "search",
    "ai",
    "diagnostics",
    "health",
    "migrations",
    "release",
    "trust",
    "sectionVersions"
  ],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "standardVersion": {"const": "2.0.0"},
    "moduleVersion": {"$ref": "#/$defs/semver"},
    "manifestSchemaVersion": {"const": "2.0.0"},
    "dataSchemaVersion": {"$ref": "#/$defs/semver"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"},
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,80}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "publisher": {"type": "object"},
    "compatibility": {"type": "object"},
    "lifecycle": {"type": "object"},
    "permissions": {"type": "array"},
    "capabilities": {"type": "array"},
    "records": {"type": "array"},
    "views": {"type": "array"},
    "actions": {"type": "array"},
    "functions": {"type": "array"},
    "settings": {"type": "array"},
    "events": {"type": "array"},
    "automations": {"type": "array"},
    "search": {"type": "array"},
    "ai": {"type": "array"},
    "diagnostics": {"type": "object"},
    "health": {"type": "object"},
    "migrations": {"type": "object"},
    "release": {"type": "object"},
    "trust": {"type": "object"},
    "backend": {"type": "object"},
    "sectionVersions": {"$ref": "#/$defs/sectionVersions"},
    "identity": {"$ref": "#/$defs/versionedSection"},
    "dependencyGraph": {"$ref": "#/$defs/dependencyGraph"},
    "serviceRegistry": {"$ref": "#/$defs/versionedSection"},
    "apiRegistry": {"$ref": "#/$defs/versionedSection"},
    "eventBus": {"$ref": "#/$defs/versionedSection"},
    "hookRegistry": {"$ref": "#/$defs/versionedSection"},
    "capabilityDiscovery": {"type": "object", "required": ["version"], "properties": {"version": {"$ref": "#/$defs/semver"}}, "additionalProperties": true},
    "healthModel": {"$ref": "#/$defs/versionedSection"},
    "diagnosticsModel": {"$ref": "#/$defs/versionedSection"},
    "metrics": {"$ref": "#/$defs/versionedSection"},
    "permissionModel": {"type": "object", "required": ["version", "categories"], "properties": {"version": {"$ref": "#/$defs/semver"}, "categories": {"type": "object"}}, "additionalProperties": false},
    "jobRegistry": {"$ref": "#/$defs/versionedSection"},
    "storageModel": {"$ref": "#/$defs/versionedSection"},
    "widgetRegistry": {"$ref": "#/$defs/versionedSection"},
    "navigationRegistry": {"$ref": "#/$defs/versionedSection"},
    "uiContributions": {"$ref": "#/$defs/versionedSection"},
    "automationRegistry": {"$ref": "#/$defs/versionedSection"},
    "offline": {"type": "object", "required": ["version", "capable"], "properties": {"version": {"$ref": "#/$defs/semver"}, "capable": {"type": "boolean"}}, "additionalProperties": true},
    "realtime": {"type": "object", "required": ["version", "events"], "properties": {"version": {"$ref": "#/$defs/semver"}, "events": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true},
    "versioning": {"type": "object", "required": ["version"], "properties": {"version": {"$ref": "#/$defs/semver"}}, "additionalProperties": true},
    "compatibilityMatrix": {"type": "object", "required": ["version", "platforms"], "properties": {"version": {"$ref": "#/$defs/semver"}, "platforms": {"type": "array", "items": {"enum": ["ios", "android", "web", "desktop", "server"]}}}, "additionalProperties": true},
    "marketplace": {"type": "object", "required": ["version"], "properties": {"version": {"$ref": "#/$defs/semver"}}, "additionalProperties": true},
    "engineReadiness": {"type": "object", "required": ["version", "engines"], "properties": {"version": {"$ref": "#/$defs/semver"}, "engines": {"type": "array", "items": {"enum": ["declarative-ui", "records", "actions", "functions", "ai", "automation", "media", "documents", "game", "webgpu", "spatial", "unity", "godot", "custom-native"]}}}, "additionalProperties": false},
    "exports": {"$ref": "#/$defs/versionedSection"},
    "imports": {"$ref": "#/$defs/versionedSection"},
    "synchronization": {"$ref": "#/$defs/versionedSection"},
    "integrations": {"$ref": "#/$defs/versionedSection"},
    "billing": {"$ref": "#/$defs/versionedSection"},
    "telemetry": {"$ref": "#/$defs/versionedSection"},
    "accessibility": {"$ref": "#/$defs/versionedSection"},
    "localization": {"$ref": "#/$defs/versionedSection"},
    "appearance": {"$ref": "#/$defs/versionedSection"},
    "onboarding": {"$ref": "#/$defs/versionedSection"}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "sectionVersions": {
      "type": "object",
      "required": [
        "identity",
        "lifecycle",
        "backend",
        "engines",
        "ai",
        "permissions",
        "settings",
        "routes",
        "views",
        "records",
        "actions",
        "functions",
        "jobs",
        "events",
        "notifications",
        "search",
        "exports",
        "imports",
        "synchronization",
        "dependencies",
        "optionalDependencies",
        "integrations",
        "billing",
        "telemetry",
        "diagnostics",
        "accessibility",
        "localization",
        "appearance",
        "onboarding",
        "migrations",
        "capabilities",
        "services",
        "apis",
        "hooks",
        "metrics",
        "storage",
        "widgets",
        "navigation",
        "ui",
        "automation",
        "offline",
        "realtime",
        "versioning",
        "compatibilityMatrix",
        "marketplace"
      ],
      "additionalProperties": false,
      "patternProperties": {"^[A-Za-z][A-Za-z0-9]*$": {"$ref": "#/$defs/semver"}}
    },
    "versionedSection": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": {"$ref": "#/$defs/semver"},
        "items": {"type": "array", "maxItems": 500, "items": {"type": "object"}},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "dependencyRef": {
      "type": "object",
      "required": ["versionRange"],
      "properties": {
        "moduleId": {"type": "string"},
        "provides": {"type": "string"},
        "versionRange": {"type": "string"},
        "reason": {"type": "string"},
        "capabilityIds": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "conflictRef": {
      "type": "object",
      "required": ["moduleId", "reason"],
      "properties": {
        "moduleId": {"type": "string"},
        "versionRange": {"type": "string"},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "provideRef": {
      "type": "object",
      "required": ["id", "title", "version", "kind"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "version": {"$ref": "#/$defs/semver"},
        "kind": {"enum": ["service", "api", "record", "capability", "engine", "integration", "ui"]}
      },
      "additionalProperties": false
    },
    "dependencyGraph": {
      "type": "object",
      "required": ["version", "requires", "optional", "recommended", "conflicts", "replaces", "provides"],
      "properties": {
        "version": {"$ref": "#/$defs/semver"},
        "requires": {"type": "array", "items": {"$ref": "#/$defs/dependencyRef"}},
        "optional": {"type": "array", "items": {"$ref": "#/$defs/dependencyRef"}},
        "recommended": {"type": "array", "items": {"$ref": "#/$defs/dependencyRef"}},
        "conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflictRef"}},
        "replaces": {"type": "array", "items": {"$ref": "#/$defs/conflictRef"}},
        "provides": {"type": "array", "items": {"$ref": "#/$defs/provideRef"}}
      },
      "additionalProperties": false
    }
  }
}
