{
  "id": "example-module",
  "type": "module",
  "version": "0.1.0",
  "runtime": {
    "mode": "svelte_component",
    "entry": "frontend/dist/modula-entry.js",
    "component_export": "default",
    "style": "frontend/dist/modula-entry.css",
    "fallback": {
      "mode": "iframe_index_html",
      "entry": "index.html"
    }
  },
  "api": {
    "namespace": "/api/modula/modules/example-module",
    "backend": "backend/router.py"
  },
  "backend": {
    "enabled": true,
    "namespace": "/api/modula/modules/example-module",
    "router": "backend/router.py",
    "models": "backend/models.py",
    "schemas": "backend/schemas.py",
    "service": "backend/service.py",
    "repository": "backend/repository.py",
    "permissions": "backend/permissions.py",
    "install": "backend/install.py",
    "uninstall": "backend/uninstall.py",
    "migrations": [
      "backend/migrations/0001_init.sql"
    ],
    "health": "/api/modula/modules/example-module/health"
  },
  "surfaces": [
    {
      "id": "main",
      "title": "Main",
      "type": "page",
      "route": "/example",
      "entry": "main"
    },
    {
      "id": "explore",
      "title": "Explore",
      "type": "page",
      "route": "/example/explore",
      "entry": "explore"
    },
    {
      "id": "settings",
      "title": "Settings",
      "type": "page",
      "route": "/example/settings",
      "entry": "settings"
    }
  ],
  "plugins": {
    "supports": true,
    "extension_points": [
      "surfaces",
      "actions",
      "composer.attachments",
      "feed.cards"
    ]
  },
  "theme": {
    "uses_modula_tokens": true
  },
  "surface_style": {
    "uses_modula_surface": true
  },
  "permissions": [
    "example.read",
    "example.write",
    "example.widget.read",
    "example.notification.emit"
  ],
  "functions": [
    {
      "id": "example.list_items",
      "title": "List items",
      "permission": "example.read"
    }
  ],
  "widgets": [
    {
      "id": "example-feed-widget",
      "title": "Example Feed Widget",
      "surface": "board"
    }
  ],
  "notifications": [
    {
      "id": "example.item.created",
      "title": "Item created",
      "default_enabled": true
    }
  ],
  "events": [
    {
      "id": "example.item.created",
      "direction": "emitted"
    },
    {
      "id": "example.refresh.requested",
      "direction": "accepted"
    }
  ]
}
