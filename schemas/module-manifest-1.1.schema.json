{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modula.digital/schemas/module-standard/1.1.0/manifest.schema.json",
  "title": "Modula Module Standard 1.1 Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "standardVersion",
    "moduleVersion",
    "manifestSchemaVersion",
    "dataSchemaVersion",
    "id",
    "slug",
    "name",
    "description",
    "publisher",
    "compatibility",
    "lifecycle",
    "permissions",
    "capabilities",
    "records",
    "views",
    "actions",
    "functions",
    "settings",
    "events",
    "automations",
    "search",
    "ai",
    "diagnostics",
    "health",
    "migrations",
    "release",
    "trust"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.1.0"},
    "standardVersion": {"const": "1.1.0"},
    "moduleVersion": {"type": "string"},
    "manifestSchemaVersion": {"const": "1.1.0"},
    "dataSchemaVersion": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"},
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,80}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "publisher": {"type": "object"},
    "compatibility": {"type": "object"},
    "lifecycle": {"type": "object"},
    "permissions": {"type": "array"},
    "capabilities": {"type": "array"},
    "records": {"type": "array"},
    "views": {"type": "array"},
    "actions": {"type": "array"},
    "functions": {"type": "array"},
    "settings": {"type": "array"},
    "events": {"type": "array"},
    "automations": {"type": "array"},
    "search": {"type": "array"},
    "ai": {"type": "array"},
    "diagnostics": {"type": "object"},
    "health": {"type": "object"},
    "migrations": {"type": "object"},
    "release": {"type": "object"},
    "trust": {"type": "object"},
    "backend": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["greenfield-managed", "module-managed", "hybrid", "frontend-only"]},
        "protocolVersion": {"type": "string"},
        "endpoints": {
          "type": "object",
          "required": ["baseUrlStrategy", "apiVersion", "healthPath"],
          "additionalProperties": false,
          "properties": {
            "baseUrlStrategy": {"enum": ["registry", "installation", "self-hosted", "user-configured"]},
            "apiVersion": {"type": "string"},
            "discoveryPath": {"type": "string", "pattern": "^/"},
            "healthPath": {"type": "string", "pattern": "^/"},
            "capabilitiesPath": {"type": "string", "pattern": "^/"},
            "actionsPath": {"type": "string", "pattern": "^/"},
            "eventsPath": {"type": "string", "pattern": "^/"},
            "webhooksPath": {"type": "string", "pattern": "^/"},
            "allowedHosts": {"type": "array", "items": {"type": "string"}}
          }
        },
        "authentication": {"type": "object"},
        "health": {"type": "object"},
        "events": {"type": "object"},
        "webhooks": {"type": "object"},
        "data": {"type": "object"},
        "deployment": {"type": "object"},
        "trust": {"type": "object"},
        "network": {"type": "object"},
        "lifecycle": {"type": "object"},
        "actions": {"type": "array"},
        "clientAccess": {"type": "object"}
      }
    }
  }
}
