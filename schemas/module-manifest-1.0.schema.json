{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modula.digital/schemas/module-standard/1.0.0/manifest.schema.json",
  "title": "Modula Module Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "standardVersion",
    "moduleVersion",
    "manifestSchemaVersion",
    "dataSchemaVersion",
    "id",
    "slug",
    "name",
    "description",
    "publisher",
    "compatibility",
    "lifecycle",
    "permissions",
    "capabilities",
    "records",
    "views",
    "actions",
    "functions",
    "settings",
    "events",
    "automations",
    "search",
    "ai",
    "diagnostics",
    "health",
    "migrations",
    "release",
    "trust"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "standardVersion": {"const": "1.0.0"},
    "moduleVersion": {"type": "string"},
    "manifestSchemaVersion": {"const": "1.0.0"},
    "dataSchemaVersion": {"type": "string"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"},
    "slug": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,80}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "website": {"type": "string"},
        "email": {"type": "string"},
        "supportUrl": {"type": "string"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "runtime", "standard", "platforms"],
      "properties": {
        "host": {"type": "string"},
        "runtime": {"type": "string"},
        "standard": {"type": "string"},
        "platforms": {"type": "array", "items": {"enum": ["ios", "android", "web", "server"]}},
        "nativeTargets": {"type": "array", "items": {"type": "string"}}
      }
    },
    "lifecycle": {"type": "object"},
    "permissions": {"type": "array"},
    "capabilities": {"type": "array"},
    "records": {"type": "array"},
    "views": {"type": "array"},
    "actions": {"type": "array"},
    "functions": {"type": "array"},
    "settings": {"type": "array"},
    "events": {"type": "array"},
    "automations": {"type": "array"},
    "search": {"type": "array"},
    "ai": {"type": "array"},
    "diagnostics": {"type": "object"},
    "health": {"type": "object"},
    "migrations": {"type": "object"},
    "release": {"type": "object"},
    "trust": {"type": "object"}
  }
}
