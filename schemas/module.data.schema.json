{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modula.digital/schemas/mms/0.2.0/module.data.schema.json",
  "title": "Modula Module Data",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "storage", "sync"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "storage": {"type": "string", "minLength": 1},
        "sync": {"type": "string", "minLength": 1},
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schemaVersion": {"const": "0.2.0"},
            "entry": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "moduleId", "resources"],
      "properties": {
        "schemaVersion": {"const": "0.2.0"},
        "moduleId": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "resources": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true,
            "required": ["type", "endpoint"],
            "properties": {
              "type": {"type": "string", "enum": ["collection", "item"]},
              "endpoint": {"type": "string", "minLength": 1},
              "storage": {"type": "string"},
              "retention": {"type": "string"},
              "sync": {"type": "string"}
            }
          }
        }
      }
    }
  ]
}
