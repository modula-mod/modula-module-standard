{
  "id": "widget-standard.stats-card",
  "slug": "stats-card",
  "title": "Stats Card Widget",
  "name": "Stats Card Widget",
  "version": "0.1.0",
  "type": "widget",
  "description": "Declarative widget package-root template for a compact stats card.",
  "author": "Modula",
