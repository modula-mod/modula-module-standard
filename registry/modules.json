        {
          "id": "update-note",
          "label": "Save note",
          "icon": "save",
          "kind": "update",
          "permission": "local-storage"
        },
        {
          "id": "delete-note",
          "label": "Delete note",
          "icon": "trash",
          "kind": "delete",
          "confirm": true,
          "destructive": true,
          "permission": "local-storage"
        },
        {
          "id": "search-notes",
          "label": "Search notes",
          "icon": "search",
          "kind": "custom",
          "permission": "local-storage"
        }
