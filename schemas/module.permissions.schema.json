{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modula.digital/schemas/mms/0.3.0/module.permissions.schema.json",
  "title": "Modula Module Permissions",
  "oneOf": [
    {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "reason", "required", "risk"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "risk": {"type": "string", "enum": ["low", "medium", "high"]},
          "scope": {"type": "string"},
          "network": {"type": "boolean"},
          "dataStored": {"type": "string"},
          "dataExported": {"type": "string"}
        }
      },
      "uniqueItems": true
    },
    {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "network", "media", "notifications", "ai"],
      "properties": {
        "storage": {"type": "boolean"},
        "network": {"type": "boolean"},
        "media": {"type": "boolean"},
        "notifications": {"type": "boolean"},
        "ai": {"type": "boolean"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "moduleId", "permissions"],
      "properties": {
        "schemaVersion": {"const": "0.3.0"},
        "moduleId": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
        "permissions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "reason", "required", "risk"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"},
              "risk": {"type": "string", "enum": ["low", "medium", "high"]},
              "level": {"type": "string", "enum": ["required", "optional"]},
              "scope": {"type": "string"},
              "network": {"type": "boolean"},
              "dataStored": {"type": "string"},
              "dataExported": {"type": "string"}
            }
          }
        }
      }
    }
  ]
}
