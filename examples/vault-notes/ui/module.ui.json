{
  "schemaVersion": "0.3.0",
  "moduleId": "vault-notes",
  "entry": "screens.index",
  "theme": {
    "preferredSurface": "solid",
    "accentRole": "privacy"
  },
  "screens": {
    "index": {
      "$ref": "ui/screens/index.ui.json"
    },
    "detail": {
      "$ref": "ui/screens/detail.ui.json"
    },
    "editor": {
      "$ref": "ui/screens/editor.ui.json"
    },
    "settings": {
      "$ref": "ui/screens/settings.ui.json"
    }
  },
  "actions": {
    "createNote": {
      "label": "New note",
      "kind": "create",
      "resource": "notes",
      "defaultPayload": {
        "title": "Untitled note",
        "body": ""
      }
    },
    "updateNote": {
      "label": "Save",
      "kind": "update",
      "resource": "notes",
      "requiresSelection": true
    },
    "deleteNote": {
      "label": "Delete",
      "kind": "delete",
      "resource": "notes",
      "requiresSelection": true,
      "confirm": true,
      "destructive": true
    },
    "selectNote": {
      "label": "Open",
      "kind": "open",
      "resource": "notes"
    },
    "searchNotes": {
      "label": "Search",
      "kind": "search",
      "resource": "notes"
    }
  },
  "resources": {
    "notes": {
      "type": "collection",
      "endpoint": "/api/modula/vault-notes",
      "responseKey": "notes",
      "itemResponseKey": "note",
      "idField": "id",
      "titleField": "title",
      "descriptionField": "body",
      "searchFields": ["title", "body"],
      "methods": {
        "list": "GET",
        "create": "POST",
        "update": "PATCH",
        "delete": "DELETE"
      }
    }
  }
}
