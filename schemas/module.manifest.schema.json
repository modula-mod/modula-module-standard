{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modula.digital/schemas/mms/0.1.0/module.manifest.schema.json",
  "title": "Modula Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mmsVersion",
    "id",
    "name",
    "version",
    "status",
    "category",
    "description",
    "entry",
    "ownerTypes",
    "permissions",
    "surfaces",
    "data",
    "ui",
    "minimumModulaVersion",
    "changelog",
    "integrity"
  ],
  "properties": {
    "mmsVersion": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"},
    "status": {
      "type": "string",
      "enum": ["local", "core", "installed", "available", "planned", "disabled", "archived"]
    },
    "category": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "component"],
      "properties": {
        "route": {"type": "string", "minLength": 1},
        "component": {"type": "string", "minLength": 1}
      }
    },
    "ownerTypes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["user", "team", "business"]}
    },
    "permissions": {"$ref": "module.permissions.schema.json"},
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board", "profile", "settings"],
      "properties": {
        "board": {"type": "boolean"},
        "profile": {"type": "boolean"},
        "settings": {"type": "boolean"}
      }
    },
    "data": {"$ref": "module.data.schema.json"},
    "ui": {"$ref": "module.ui.schema.json"},
    "minimumModulaVersion": {"type": "string"},
    "changelog": {
      "type": "array",
      "items": {"$ref": "module.version.schema.json"}
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "signature"],
      "properties": {
        "hash": {"type": ["string", "null"]},
        "signature": {"type": ["string", "null"]}
      }
    }
  }
}

