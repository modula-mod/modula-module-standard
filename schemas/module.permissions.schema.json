{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modula.digital/schemas/mms/0.1.2/module.permissions.schema.json",
  "title": "Modula Module Permissions",
  "oneOf": [
    {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "network", "media", "notifications", "ai"],
      "properties": {
        "storage": {"type": "boolean"},
        "network": {"type": "boolean"},
        "media": {"type": "boolean"},
        "notifications": {"type": "boolean"},
        "ai": {"type": "boolean"}
      }
    }
  ]
}
