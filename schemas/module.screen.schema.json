{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modula.digital/schemas/mms/0.3.0/module.screen.schema.json",
  "title": "Modula Module Screen",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "layout", "sections"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string"},
    "layout": {
      "type": "string",
      "enum": ["module-list-detail", "task-list", "detail", "editor", "stack"]
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "hero",
              "search",
              "filters",
              "resourceList",
              "resourceDetail",
              "emptyState",
              "actionRow",
              "notice",
              "stats"
            ]
          },
          "title": {"type": "string"},
          "subtitle": {"type": "string"},
          "description": {"type": "string"},
          "placeholder": {"type": "string"},
          "resource": {"type": "string"},
          "actions": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "options": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "emptyState": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title"],
            "properties": {
              "title": {"type": "string", "minLength": 1},
              "description": {"type": "string"},
              "action": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
